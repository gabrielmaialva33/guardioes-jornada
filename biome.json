{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!build",
			"!.svelte-kit",
			"!node_modules",
			"!src/lib/icons.generated.ts",
			"!src/lib/supabase/database.types.ts",
			"!static",
			"!.agents",
			"!.claude",
			"!supabase/.temp",
			"!pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 110
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "none"
		}
	},
	"css": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"linter": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"formatter": {
				"enabled": false
			},
			"assist": {
				"enabled": false
			},
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
